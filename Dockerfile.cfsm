FROM golang:1.26.8-alpine AS builder

WORKDIR /build

COPY . .

# 不写死 GOARCH，让 buildx 按目标架构编译
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X main.version=cfsm-agent" -o /cf-probe ./cmd/cf-probe

FROM alpine:3.21

RUN apk add --no-cache ca-certificates

COPY --from=builder /cf-probe /usr/local/bin/cf-probe
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

