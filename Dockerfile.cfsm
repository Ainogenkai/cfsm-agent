FROM golang:1.26.8-alpine AS builder

WORKDIR /build

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w -X main.version=cfsm-agent" -o /cf-probe ./cmd/cf-probe

FROM alpine:3.21

# 安装 CA 证书（HTTPS/WSS 所需）
RUN apk add --no-cache ca-certificates

WORKDIR /app

# 复制构建产物
COPY --from=builder /cf-probe /usr/local/bin/cf-probe

# 复制 entrypoint
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh

# 容器以正常方式启动（前台）
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
